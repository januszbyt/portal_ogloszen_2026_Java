<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="400.0" minWidth="300.0" stylesheets="@wyszukiwarka.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.WyszukiwarkaController">
   <top>
      <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" minHeight="40.0" minWidth="200.0" prefHeight="60.0" styleClass="header-bar" BorderPane.alignment="CENTER">
         <children>
            <Label text="Wyszukiwarka ogłoszeń" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Label>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblWelcome" text="Witaj!" textFill="WHITE">
                     <HBox.margin>
                        <Insets right="15.0" />
                     </HBox.margin>
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  
                  <Button fx:id="btnToggleTheme" mnemonicParsing="false" onAction="#handleToggleTheme" styleClass="theme-button" text="🌙 Ciemny Motyw" />
                  
                  <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#handleMojProfil" styleClass="button-secondary" text="Mój Profil">
                     <HBox.margin>
                        <Insets left="10.0" right="10.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="btnLogout1" mnemonicParsing="false" onAction="#handleLogout" styleClass="button-danger" text="Wyloguj">
                     <HBox.margin>
                        <Insets right="20.0" />
                     </HBox.margin>
                  </Button>
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </HBox>
         </children>
      </HBox>
   </top>
   <center>
      <TabPane fx:id="tabPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <Tab text="Wyszukaj ogłoszenia">
               <content>
                  <BorderPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="200.0" prefWidth="200.0">
                     <center>
                        <TableView fx:id="tableUsers" minHeight="150.0" minWidth="300.0" BorderPane.alignment="CENTER">
                           <columns>
                             <TableColumn fx:id="colCompany" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="120.0" reorderable="false" text="Pracodawca" />
                             <TableColumn fx:id="colUserId" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="70.0" reorderable="false" text="Tytuł" />
                             <TableColumn fx:id="colUserRole" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="70.0" reorderable="false" text="Kategoria" />
                               <TableColumn fx:id="colUserEmail" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="70.0" reorderable="false" text="Lokalizacja" />
                               <TableColumn fx:id="colUserDate" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="100.0" reorderable="false" text="Wynagrodzenie" />
                               <TableColumn fx:id="colUserStatus" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="100.0" reorderable="false" text="Status" />
                           </columns>
                           <BorderPane.margin>
                              <Insets left="15.0" right="15.0" />
                           </BorderPane.margin>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </center>
                     <bottom>
                        <HBox alignment="CENTER" prefHeight="40.0" prefWidth="763.0" spacing="15.0" BorderPane.alignment="CENTER">
                           <padding>
                              <Insets left="15.0" right="15.0" />
                           </padding>
                           <children>
                              <Button fx:id="btnViewOffer1" mnemonicParsing="false" styleClass="button" text="Podgląd ogłoszenia" />
                           </children>
                        </HBox>
                     </bottom>
                     <top>
                        <VBox spacing="10.0" BorderPane.alignment="TOP_CENTER">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="15.0">
                                 <children>
                                    <TextField fx:id="txtSearchUser" minWidth="100.0" prefWidth="300.0" promptText="Szukaj pracy..." />
                                    <Button fx:id="btnRefreshOffers" minWidth="50.0" mnemonicParsing="false" onAction="#handleRefreshOffers" prefHeight="36.0" styleClass="button" text="Odśwież" />
                                    <Button fx:id="btnSearchUser1" minWidth="50.0" mnemonicParsing="false" onAction="#obslugaPrzyciskuFiltry" prefHeight="36.0" styleClass="button-secondary" text="Filtry" />
                                 </children>
                                 <padding>
                                    <Insets left="15.0" right="15.0" />
                                 </padding>
                              </HBox>
                              <HBox fx:id="panelFiltrow" alignment="CENTER_LEFT" fillHeight="false" prefHeight="0.0" spacing="10.0">
                                 <children>
                                    <TextField fx:id="txtTitleFilter" prefHeight="46.0" promptText="Tytuł stanowiska" />
                                    <ComboBox fx:id="comboCategoryFilter" prefHeight="46.0" prefWidth="500.0" promptText="Kategoria (Branża)" />
                                    <TextField fx:id="txtLocationFilter" prefHeight="46.0" promptText="Lokalizacja" />
                                    <TextField fx:id="txtMinSalaryFilter" prefHeight="46.0" promptText="Minimalne wynagrodzenie" />
                                 </children>
                                 <padding>
                                    <Insets left="10.0" right="10.0" />
                                 </padding>
                                 <VBox.margin>
                                    <Insets left="5.0" right="5.0" />
                                 </VBox.margin>
                              </HBox>
                           </children>
                           <BorderPane.margin>
                              <Insets />
                           </BorderPane.margin>
                           <padding>
                              <Insets bottom="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </top>
                  </BorderPane>
               </content>
          </Tab>
          <Tab text="Historia ogłoszeń">
               <content>
                  <BorderPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="200.0" prefWidth="200.0">
                     <center>
                        <TableView fx:id="tableUsers1" minHeight="150.0" minWidth="300.0" BorderPane.alignment="CENTER">
                           <columns>
                              <TableColumn fx:id="colCompany1" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="120.0" reorderable="false" text="Pracodawca" />
                              <TableColumn fx:id="colUserId1" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="70.0" reorderable="false" text="Stanowisko" />
                              <TableColumn fx:id="colUserRole1" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="70.0" reorderable="false" text="Branża" />
                              <TableColumn fx:id="colUserEmail1" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="70.0" reorderable="false" text="Lokalizacja" />
                              <TableColumn fx:id="colUserDate1" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="100.0" reorderable="false" text="Wynagrodzenie" />
                              <TableColumn fx:id="colUserStatus1" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="100.0" reorderable="false" text="Status" />
                           </columns>
                           <BorderPane.margin>
                              <Insets left="15.0" right="15.0" />
                           </BorderPane.margin>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </center>
                     <bottom>
                        <HBox alignment="CENTER" prefHeight="40.0" spacing="15.0" BorderPane.alignment="CENTER">
                           <padding>
                              <Insets left="15.0" right="15.0" />
                           </padding>
                            <children>
                               <Button fx:id="btnViewOffer11" mnemonicParsing="false" styleClass="button" text="Podgląd ogłoszenia" />
                            </children>
                        </HBox>
                     </bottom>
                     <top>
                        <VBox spacing="10.0" BorderPane.alignment="TOP_CENTER">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="15.0">
                                 <children>
                                    <TextField fx:id="txtSearchUser1" minWidth="100.0" prefWidth="300.0" promptText="Szukaj pracy (fraza)..." />
                                    <Button fx:id="btnRefreshHistory" minWidth="50.0" mnemonicParsing="false" onAction="#handleRefreshHistory" prefHeight="36.0" styleClass="button" text="Odśwież" />
                                 </children>
                                 <padding>
                                    <Insets left="15.0" right="15.0" />
                                 </padding>
                              </HBox>
                           </children>
                           <BorderPane.margin>
                              <Insets />
                           </BorderPane.margin>
                           <padding>
                              <Insets bottom="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </top>
                  </BorderPane>
               </content>
          </Tab>
        </tabs>
      </TabPane>
   </center>
</BorderPane>