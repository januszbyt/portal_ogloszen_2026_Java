<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="400.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.LoginController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <children>
      <Label text="Logowanie" />
      
      <VBox alignment="CENTER" maxWidth="-Infinity" prefHeight="62.0" prefWidth="300.0" spacing="10.0">
         <children>
            <TextField fx:id="emailField" maxWidth="1.7976931348623157E308" promptText="Email" />
            <PasswordField fx:id="passwordField" maxWidth="1.7976931348623157E308" promptText="Hasło" />
         </children>
      </VBox>

      <HBox alignment="CENTER" maxWidth="-Infinity" prefHeight="18.0" prefWidth="282.0" spacing="20.0">
         <children>
            <RadioButton fx:id="userRadio" mnemonicParsing="false" selected="true" text="Użytkownik">
               <toggleGroup>
                  <ToggleGroup fx:id="roleGroup" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="businessRadio" mnemonicParsing="false" text="Przedsiębiorca" toggleGroup="$roleGroup" />
         </children>
      </HBox>

      <VBox alignment="CENTER" maxWidth="-Infinity" prefHeight="94.0" prefWidth="192.0" spacing="10.0">
         <children>
            <Button fx:id="loginButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogin" text="Zaloguj się" />
            <Hyperlink fx:id="registerLink" onAction="#handleRegister" text="Zarejestruj się" />
            <Hyperlink fx:id="skipLink" onAction="#handleSkip" text="Kontynuuj bez logowania" />
         </children>
      </VBox>
   </children>
</VBox>
