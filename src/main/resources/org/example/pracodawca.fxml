<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox minHeight="500.0" minWidth="850.0" prefHeight="600.0" prefWidth="900.0" spacing="15.0" stylesheets="@pracodawca.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.PracodawcaController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" minWidth="340.0" prefWidth="340.0" style="-fx-background-color: transparent; -fx-background: transparent;">
         <content>
            <VBox minWidth="315.0" prefWidth="315.0" spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
               <children>
                  <Label text="Zarządzanie Ogłoszeniem">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Separator prefWidth="200.0" />
                  
                  <Label text="Tytuł oferty:" />
                  <TextField fx:id="titleField" promptText="np. Senior Java Developer" />
                  
                  <Label text="Kategoria / Branża:" />
                  <!-- POPRAWIONO: maxWidth rozciąga pole równo do Tytułu oferty -->
                  <ComboBox fx:id="categoryCombo" maxWidth="1.7976931348623157E308" promptText="Wybierz kategorię..." />
                  
                  <Label text="Lokalizacja:" />
                  <TextField fx:id="locationField" promptText="np. Warszawa / Zdalnie" />
                  
                  <Label text="Wynagrodzenie (PLN):" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="salaryMinField" prefWidth="110.0" promptText="Min" />
                        <Label alignment="CENTER" prefWidth="20.0" text="do" />
                        <TextField fx:id="salaryMaxField" prefWidth="110.0" promptText="Max" />
                     </children>
                  </HBox>
                  
                  <Label text="Opis stanowiska / Wymagania:" />
                  <TextArea fx:id="descriptionArea" prefHeight="120.0" promptText="Wpisz szczegóły ogłoszenia..." wrapText="true" VBox.vgrow="ALWAYS" />
                  
                  <Separator prefWidth="200.0" />
                  <HBox spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleAddOffer" prefWidth="140.0" text="Dodaj Nowe" />
                        <Button mnemonicParsing="false" onAction="#handleSaveEdit" prefWidth="140.0" text="Zapisz Edycję" />
                     </children>
                  </HBox>

                  <Button mnemonicParsing="false" onAction="#handleMojProfil" prefWidth="298.0" style="-fx-background-color: #E0E0E0; -fx-text-fill: #000000; -fx-cursor: hand;" text="Mój Profil">
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Button>
                  
                  <Button mnemonicParsing="false" onAction="#handleLogout" prefWidth="298.0" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-cursor: hand;" text="Wyloguj się">
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </Button>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <VBox prefWidth="535.0" spacing="15.0" HBox.hgrow="ALWAYS" style="-fx-padding: 0 0 0 0;">
         <children>
            <HBox alignment="TOP_RIGHT" prefHeight="40.0">
               <children>
                  <Button fx:id="btnToggleTheme" mnemonicParsing="false" onAction="#handleToggleTheme" styleClass="button, theme-btn" text="🌙 Ciemny Motyw" />
               </children>
            </HBox>
            
            <VBox prefHeight="320.0" spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Twoje Aktywne i Zakończone Ogłoszenia:">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TableView fx:id="offersTable" prefHeight="250.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colTitle" prefWidth="220.0" text="Tytuł Oferty" />
                        <TableColumn fx:id="colCategory" prefWidth="160.0" text="Kategoria" />
                        <TableColumn fx:id="colLocation" prefWidth="160.0" text="Lokalizacja" />
                        <TableColumn fx:id="colSalary" prefWidth="180.0" text="Wynagrodzenie" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <HBox spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleEditClick" text="Edytuj Wybrane" />
                        <Button mnemonicParsing="false" onAction="#handleCloseClick" text="Zakończ Rekrutację" />
                        <Button mnemonicParsing="false" onAction="#handleDeleteOffer" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-cursor: hand;" text="Usuń z Bazy" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <VBox prefHeight="220.0" spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Aplikacje kandydatów na wybrane ogłoszenie:">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <ListView fx:id="candidatesListView" prefHeight="140.0" VBox.vgrow="ALWAYS" />
                  <HBox spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleChangeStatusAccept" style="-fx-background-color: #2a3b4c; -fx-text-fill: white;" text="Rozpatruj (W toku)" />
                        <Button mnemonicParsing="false" onAction="#handleChangeStatusReject" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-cursor: hand;" text="Odrzuć Aplikację" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</HBox>